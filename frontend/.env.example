# Server-side Next.js rewrite target. No OpenAI credentials belong here.
TALLYBINDER_BACKEND_URL=http://127.0.0.1:8000
# Comma-separated hostnames allowed to load Next development assets, e.g. your LAN IP.
TALLYBINDER_DEV_ORIGINS=

# Public Firebase web-app configuration. These values identify the Firebase app;
# they are not server secrets. Keep service-account and OpenAI keys off Vercel.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR-PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR-PROJECT
NEXT_PUBLIC_FIREBASE_APP_ID=
