# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY requirements-cloud.txt ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then PIP_CERT=/run/secrets/proxy_ca pip install --no-cache-dir -r requirements-cloud.txt; else pip install --no-cache-dir -r requirements-cloud.txt; fi
COPY --chown=10001:10001 cardscan ./cardscan
COPY --chown=10001:10001 experiments/structured-prices/targets.json ./experiments/structured-prices/targets.json
RUN useradd --uid 10001 --create-home app
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn","cardscan.local_pricing.api:app","--host","0.0.0.0","--port","8000","--workers","1","--no-proxy-headers","--timeout-graceful-shutdown","90"]
