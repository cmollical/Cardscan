# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY requirements-cloud.txt requirements-serverless.txt ./
RUN pip install --no-cache-dir -r requirements-serverless.txt
COPY --chown=10001:10001 cardscan ./cardscan
COPY --chown=10001:10001 experiments/structured-prices/targets.json ./experiments/structured-prices/targets.json
RUN useradd --uid 10001 --create-home app
USER 10001:10001
EXPOSE 8080
CMD ["sh","-c","uvicorn ${TALLYBINDER_APP_MODULE:-cardscan.cloud.api:app} --host 0.0.0.0 --port ${PORT:-8080} --workers 1 --no-proxy-headers --timeout-graceful-shutdown 90"]
