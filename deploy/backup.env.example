# Root-only /srv/tallybinder/config/backup.env; chmod 600, outside Git.
# Existing PRIVATE OCI Object Storage bucket, S3 compatibility endpoint, home region.
RESTIC_REPOSITORY=s3:https://NAMESPACE.compat.objectstorage.REGION.oraclecloud.com/BUCKET/tallybinder
RESTIC_PASSWORD_FILE=/srv/tallybinder/config/restic-password
AWS_ACCESS_KEY_ID=YOUR_SCOPED_OCI_CUSTOMER_SECRET_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SCOPED_OCI_CUSTOMER_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=YOUR_HOME_REGION
