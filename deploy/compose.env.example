# Nonsecret operator values; --env-file on docker compose selects these.
TALLYBINDER_HOST=YOUR-EXISTING-OR-FREE-DNS-HOSTNAME
TALLYBINDER_ACME_EMAIL=YOUR-CERTIFICATE-CONTACT-EMAIL
TALLYBINDER_RELEASE=local
TALLYBINDER_DATA_DIR=/srv/tallybinder/data
TALLYBINDER_CONFIG_DIR=/srv/tallybinder/config
TALLYBINDER_ENV_FILE=/srv/tallybinder/config/app.env
TALLYBINDER_BACKUP_DIR=/srv/tallybinder/backups
TALLYBINDER_TLS_DIR=/srv/tallybinder/tls
