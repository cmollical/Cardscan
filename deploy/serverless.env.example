# Nonsecret Cloud Run service/job values.
GOOGLE_CLOUD_PROJECT=YOUR-PROJECT
TALLYBINDER_CLOUD=true
TALLYBINDER_DB=/tmp/tallybinder/database.sqlite
TALLYBINDER_JOB_MODE=external
TALLYBINDER_STORAGE_BUCKET=YOUR_PRIVATE_BUCKET
TALLYBINDER_PRICING_OBJECT=pricing/database.sqlite
TALLYBINDER_FIRESTORE_DATABASE=(default)
TALLYBINDER_FIRESTORE_PREFIX=tallybinder
TALLYBINDER_ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
TALLYBINDER_AI_ENABLED=false
TALLYBINDER_AI_MODEL=gpt-5.4-mini
TALLYBINDER_AI_INPUT_RATE=0.75
TALLYBINDER_AI_OUTPUT_RATE=4.50
TALLYBINDER_AI_MAX_INPUT_TOKENS=400000
TALLYBINDER_AI_MAX_OUTPUT_TOKENS=2000
TALLYBINDER_AI_PER_JOB_USD=0.50
TALLYBINDER_AI_DAILY_USD=5.00
TALLYBINDER_AI_DAILY_JOBS=30
TALLYBINDER_TASKS_LOCATION=us-east1
TALLYBINDER_VISION_QUEUE=tallybinder-vision
TALLYBINDER_VISION_WORKER_URL=https://YOUR-CLOUD-RUN-API.run.app
TALLYBINDER_TASKS_SERVICE_ACCOUNT=tallybinder-tasks@YOUR-PROJECT.iam.gserviceaccount.com
# Cloud Run only, from Secret Manager rather than a plain environment value:
# OPENAI_API_KEY=secret:openai-api-key:latest
# Explicit provider category:set identifiers, maximum fifteen.
TALLYBINDER_DAILY_SCOPES=3:23228,3:23237,3:604,3:630,85:23599
TALLYBINDER_DAILY_MAX_REQUESTS=64
