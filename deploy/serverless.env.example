# Nonsecret Cloud Run service/job values.
TALLYBINDER_CLOUD=true
TALLYBINDER_DB=/tmp/tallybinder/database.sqlite
TALLYBINDER_JOB_MODE=external
TALLYBINDER_STORAGE_BUCKET=YOUR_PRIVATE_BUCKET
TALLYBINDER_PRICING_OBJECT=pricing/database.sqlite
TALLYBINDER_FIRESTORE_DATABASE=(default)
TALLYBINDER_FIRESTORE_PREFIX=tallybinder
TALLYBINDER_ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
TALLYBINDER_AI_ENABLED=false
# Explicit provider category:set identifiers, maximum fifteen.
TALLYBINDER_DAILY_SCOPES=3:23228,3:23237,3:604,3:630,85:23599
TALLYBINDER_DAILY_MAX_REQUESTS=64
