# PRIVATE VM file /srv/tallybinder/config/app.env; chmod 600. Never commit real values.
TALLYBINDER_CLOUD=true
TALLYBINDER_DB=/data/database.sqlite
TALLYBINDER_MEDIA_DIR=/data/photos
TALLYBINDER_JOB_MODE=external
TALLYBINDER_ACCESS_TOKEN=REPLACE_WITH_RANDOM_PERSONAL_ACCESS_KEY_AT_LEAST_32_CHARACTERS
TALLYBINDER_SESSION_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TALLYBINDER_ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
# Enable deliberately after paid-AI authorization and supplying a real backend key.
TALLYBINDER_AI_ENABLED=false
OPENAI_API_KEY=
TALLYBINDER_AI_MODEL=gpt-5.4-mini
TALLYBINDER_AI_INPUT_RATE=0.75
TALLYBINDER_AI_OUTPUT_RATE=4.50
TALLYBINDER_AI_MAX_INPUT_TOKENS=400000
TALLYBINDER_AI_MAX_OUTPUT_TOKENS=2000
TALLYBINDER_AI_PER_JOB_USD=0.50
TALLYBINDER_AI_DAILY_USD=5.00
TALLYBINDER_AI_DAILY_JOBS=30
