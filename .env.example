# Backend only. Export these variables before starting uvicorn.
TALLYBINDER_DB=local-evidence/tallybinder.sqlite
TALLYBINDER_MEDIA_DIR=local-evidence/tallybinder-photos
# Optional personal app access token, required before exposing beyond trusted localhost.
TALLYBINDER_ACCESS_TOKEN=
TALLYBINDER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost:3000,https://127.0.0.1:3000
# Paid AI stays disabled until explicitly authorized by the operator.
TALLYBINDER_AI_ENABLED=false
OPENAI_API_KEY=
TALLYBINDER_AI_MODEL=gpt-5.4-mini
TALLYBINDER_AI_INPUT_RATE=0.75
TALLYBINDER_AI_OUTPUT_RATE=4.50
TALLYBINDER_AI_MAX_INPUT_TOKENS=400000
TALLYBINDER_AI_MAX_OUTPUT_TOKENS=2000
TALLYBINDER_AI_PER_JOB_USD=0.50
TALLYBINDER_AI_DAILY_USD=5.00
TALLYBINDER_AI_DAILY_JOBS=30
# Local defaults. Cloud requires long distinct secrets, exact HTTPS origins and external worker.
TALLYBINDER_CLOUD=false
TALLYBINDER_SESSION_SECRET=
TALLYBINDER_JOB_MODE=background
